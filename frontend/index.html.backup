      <div style="background: white; border: 1.5px solid var(--border); border-radius: 16px; padding: 1.4rem; text-align: center; transition: all 0.25s; cursor: pointer;" onmouseover="this.style.borderColor=getComputedStyle(document.documentElement).getPropertyValue('--teal').trim(); this.style.transform='translateY(-3px)'; this.style.boxShadow='0 8px 24px rgba(27,158,139,0.1)';" onmouseout="this.style.borderColor=getComputedStyle(document.documentElement).getPropertyValue('--border').trim(); this.style.transform='translateY(0)'; this.style.boxShadow='none';">
        <div style="width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(135deg, var(--teal), var(--teal2)); color: white; font-size: 16px; font-weight: 900; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem;">1</div>
        <div style="font-size: 14px; font-weight: 900; color: var(--ink); margin-bottom: 0.4rem;">テーマ発表・情報共有</div>
        <div style="font-size: 12px; color: var(--muted); line-height: 1.5;">行政からビジョンや計画背景を丁寧に説明します</div>
      </div>

