    </div>

    <div class="pill-label">Online Spaces</div>
    <h3 class="section-title" style="margin-top: 0.5rem; margin-bottom: 1.2rem;">参加できるオンラインとりくみ</h3>
    <div class="spaces-grid">
      <div class="space-card">
        <div class="sc-thumb" style="background: linear-gradient(135deg, #D0F0EB, #9FE1CB);"><span class="sc-badge b-open">受付中</span>🌊</div>
        <div class="sc-body">
          <div class="sc-cat">アイデア募集</div>
          <div class="sc-title">柳井湾岸エリアの活用アイデアを募集</div>
          <div class="sc-footer">
            <div class="sc-meta">📅 締切：3月31日</div>
            <div class="sc-voices">87件の声</div>
          </div>
        </div>
      </div>
      <div class="space-card">
        <div class="sc-thumb" style="background: linear-gradient(135deg, #FFF0C2, #FAC775);"><span class="sc-badge b-open">受付中</span>🏘</div>
        <div class="sc-body">
          <div class="sc-cat">アイデア募集</div>
          <div class="sc-title">まちなか空き店舗・空き地の活用方法</div>
          <div class="sc-footer">
            <div class="sc-meta">📅 締切：4月15日</div>
            <div class="sc-voices">124件の声</div>
          </div>
        </div>
      </div>
      <div class="space-card">
        <div class="sc-thumb" style="background: linear-gradient(135deg, #E6F1FB, #85B7EB);"><span class="sc-badge b-soon">近日</span>🚶</div>
        <div class="sc-body">
          <div class="sc-cat">意向調査</div>
          <div class="sc-title">歩行者にやさしい道路・広場づくり</div>
          <div class="sc-footer">
            <div class="sc-meta">📅 3月15日〜</div>
            <div class="sc-voices">56件の声</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="scripts/mock-data.js"></script>
<script src="scripts/api-client.js"></script>
<script>
  // Panel switcher
  function showPanel(id, btn) {
    document.querySelectorAll('.vpanel').forEach(p => p.classList.remove('active'));
    document.querySelectorAll('.ttab').forEach(t => t.classList.remove('active'));
    document.getElementById('panel-' + id).classList.add('active');
    if (btn) btn.classList.add('active');
    window.scrollTo({ top: 64, behavior: 'smooth' });
  }

  // Map API data to display format
  function mapProjectsForDisplay(projects) {
    const typeMap = { ws: 'ワークショップ', idea: 'アイデア募集', online: 'オンライン参加', observation: '観察' };
    const iconMap = { ws: '🌊', idea: '🏘', online: '💻', observation: '👀' };
    const bgMap = {
      ws: 'linear-gradient(135deg,#D0F0EB,#9FE1CB)',
      idea: 'linear-gradient(135deg,#FFF0C2,#FAC775)',
      online: 'linear-gradient(135deg,#E6F1FB,#85B7EB)',
      observation: 'linear-gradient(135deg,#F0E6FB,#D4C5EB)'
    };

    return projects.map((p, i) => ({
      id: p.id,
      type: p.type,
      badge: p.status === 'OPEN' ? 'open' : p.status === 'CLOSED' ? 'done' : 'soon',
      icon: iconMap[p.type] || '🎯',
      bg: bgMap[p.type] || 'linear-gradient(135deg,#D0F0EB,#9FE1CB)',
      category: typeMap[p.type] || p.type,
      title: p.title,
      description: p.description || '',
      voices: Math.floor(Math.random() * 100) + 20, // ダミー音声数
      date: p.created_at ? new Date(p.created_at).toLocaleDateString('ja-JP') : '日程未定',
      status: p.status
    }));
  }

  // Render projects grid
  function renderProjects(projects) {
    const grid = document.getElementById('gridB');
    grid.innerHTML = projects.map(p => `
      <div class="space-card">
        <div class="sc-thumb" style="background: ${p.bg}">
          <span class="sc-badge ${p.badge}">${['open', 'soon', 'done'].includes(p.badge) ? (p.badge === 'open' ? '受付中' : p.badge === 'soon' ? '近日開催' : '終了') : '未定'}</span>
          ${p.icon}
        </div>
        <div class="sc-body">
          <div class="sc-cat">${p.category}</div>
          <div class="sc-title">${p.title}</div>
          <div class="sc-footer">
            <div class="sc-meta">📅 ${p.date}</div>
            ${p.voices > 0 ? `<div class="sc-voices">💬 ${p.voices}件</div>` : ''}
          </div>
        </div>
      </div>
    `).join('');
  }

  // Render filter chips
  function renderChips() {
    const chips = document.getElementById('chips');
    chips.innerHTML = `
      <button class="chip active" onclick="filterProjects('all', this)">すべて</button>
      <button class="chip" onclick="filterProjects('ws', this)">WS</button>
      <button class="chip" onclick="filterProjects('idea', this)">アイデア</button>
      <button class="chip" onclick="filterProjects('online', this)">オンライン</button>
    `;
  }

  // Store all projects for filtering
  let allProjects = [];

  function filterProjects(type, btn) {
    document.querySelectorAll('#chips .chip').forEach(c => c.classList.remove('active'));
    btn.classList.add('active');
    if (type === 'all') {
      renderProjects(allProjects);
    } else {
      renderProjects(allProjects.filter(p => p.type === type));
    }
  }

  // Render dashboard bars
  function renderBars(keywords) {
    const bars = document.getElementById('barsB');
    bars.innerHTML = (keywords || []).map(k => `
      <div class="mini-bar">
        <div class="mb-lbl">${k.label}</div>
        <div class="mb-track"><div class="mb-fill" style="width: ${Math.min(k.count * 10, 100)}%; background: ${getColor(k.label)}"></div></div>
        <div class="mb-val">${k.count}</div>
      </div>
    `).join('');
  }

  function getColor(label) {
    const colors = {
      '海・水辺': '#1B9E8B',
      '空き店舗': '#FFB703',
      '歩道・広場': '#6B4EFF',
      '緑・公園': '#3BB573',
      'イベント': '#FF8C69'
    };
    return colors[label] || '#1B9E8B';
  }

  // Render sparkline
  function renderSparkline(sparklineData) {
    const spk = document.getElementById('spkB');
    const data = sparklineData || [45, 52, 48, 65, 72, 68, 82];
    const maxVal = Math.max(...data);
    spk.innerHTML = data.map((v, i) => `
      <div class="sp-bar" style="height: ${(v / maxVal) * 100}%; ${i >= data.length - 2 ? 'background: var(--teal)' : ''}"></div>
    `).join('');
  }

  // Counter animation
  function animateCounter(targetCount) {
    let count = 0;
    const target = targetCount || 342;
    const step = Math.ceil(target / 40);
    const interval = setInterval(() => {
      count = Math.min(count + step, target);
      document.getElementById('cntB').textContent = count;
      document.getElementById('cntB2').textContent = count;
      if (count >= target) clearInterval(interval);
    }, 25);
  }

  // Initialize with API data
  async function initialize() {
    try {
      // Fetch projects and dashboard data
      const projectsData = await fetchProjects();
      const dashboardData = await fetchDashboardStats();

      // Map projects for display
      allProjects = mapProjectsForDisplay(projectsData);

      // Render UI
      renderChips();
      renderProjects(allProjects);
      renderBars(dashboardData.keywords || []);
      renderSparkline(dashboardData.sparklineData || [45, 52, 48, 65, 72, 68, 82]);
      animateCounter(dashboardData.totalVoices || 342);
    } catch (error) {
      console.error('Initialization error:', error);
      // Fallback to mock data if API fails
      console.log('Falling back to mock data...');
      // renderChips();
      // renderProjects(MockData.PROJECTS);
      // renderBars();
      // renderSparkline();
      // animateCounter();
    }
  }

  // Start initialization
  initialize();
</script>

</body>
</html>
