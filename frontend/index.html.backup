        <div style="width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(135deg, var(--teal), var(--teal2)); color: white; font-size: 16px; font-weight: 900; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem;">2</div>
